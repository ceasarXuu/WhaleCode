{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/candidate-artifact-content-v1.schema.json",
  "title": "R7 continuous-action candidate artifacts",
  "oneOf": [
    {"$ref": "#/$defs/l4Schema"},
    {"$ref": "#/$defs/transitionSchema"},
    {"$ref": "#/$defs/typedOutcome"},
    {"$ref": "#/$defs/lifecycleOracle"},
    {"$ref": "#/$defs/capabilityMatrix"},
    {"$ref": "#/$defs/rollbackManifest"},
    {"$ref": "#/$defs/continuousActionEvaluation"},
    {"$ref": "#/$defs/fla8Evaluation"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "metricSet": {
      "type": "object",
      "required": ["transition_carrier_rate", "carrier_execution_started_rate", "correctness_rate"],
      "properties": {
        "transition_carrier_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "carrier_execution_started_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "correctness_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "thresholdSet": {
      "type": "object",
      "required": ["transition_carrier_rate_min", "correctness_rate_min"],
      "properties": {
        "transition_carrier_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
        "correctness_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
        "request_amplification_max": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "l4Schema": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "provider_tool"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "l4_schema"},
        "provider_tool": {
          "type": "object",
          "required": ["name", "wire_kind", "carrier_field", "business_parameters", "standard_unchanged"],
          "properties": {
            "name": {"$ref": "#/$defs/nonEmptyString"},
            "wire_kind": {"enum": ["function", "taskspace_function_projection"]},
            "carrier_field": {"const": "taskspace_transition"},
            "business_parameters": {
              "type": "object",
              "required": ["type", "properties"],
              "properties": {
                "type": {"const": "object"},
                "properties": {"type": "object", "minProperties": 1}
              },
              "additionalProperties": true
            },
            "standard_unchanged": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transitionSchema": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "transition_schema"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "transition_schema"},
        "transition_schema": {
          "type": "object",
          "required": ["schema_id", "actions", "required_fields", "standalone_nonterminal_allowed"],
          "properties": {
            "schema_id": {"$ref": "#/$defs/nonEmptyString"},
            "actions": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {"enum": ["initialize_map", "bind_node", "complete_then_continue"]},
              "allOf": [
                {"contains": {"const": "initialize_map"}},
                {"contains": {"const": "bind_node"}},
                {"contains": {"const": "complete_then_continue"}}
              ]
            },
            "required_fields": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["action", "expected_revision", "current_node_id", "next_node_id", "root_goal"]},
              "allOf": [
                {"contains": {"const": "action"}},
                {"contains": {"const": "expected_revision"}}
              ]
            },
            "standalone_nonterminal_allowed": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "typedOutcome": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "outcome_type", "outcome_variants", "tool_output_preservation", "post_hook_separate"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "typed_outcome"},
        "outcome_type": {"const": "TaskSpaceCarrierOutcome"},
        "outcome_variants": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["RejectedBeforeCommit", "CommittedNotExecuted", "Executed"]},
          "allOf": [
            {"contains": {"const": "RejectedBeforeCommit"}},
            {"contains": {"const": "CommittedNotExecuted"}},
            {"contains": {"const": "Executed"}}
          ]
        },
        "tool_output_preservation": {"const": "opaque"},
        "post_hook_separate": {"const": true}
      },
      "additionalProperties": false
    },
    "oracleEntry": {
      "type": "object",
      "required": ["id", "given", "when", "then"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "given": {"$ref": "#/$defs/nonEmptyString"},
        "when": {"$ref": "#/$defs/nonEmptyString"},
        "then": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "lifecycleOracle": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "oracle_version", "oracles"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "lifecycle_oracle_v2"},
        "oracle_version": {"const": 2},
        "oracles": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/oracleEntry"}}
      },
      "additionalProperties": false
    },
    "capabilityEntry": {
      "type": "object",
      "required": ["wire_api", "tool_spec", "invocation_source", "disposition", "reason"],
      "properties": {
        "wire_api": {"enum": ["deepseek_chat", "responses"]},
        "tool_spec": {"enum": ["Function", "Namespace", "ToolSearch", "LocalShell", "ImageGeneration", "WebSearch", "Freeform"]},
        "invocation_source": {"enum": ["builtin", "dynamic", "mcp", "code_mode", "nested"]},
        "disposition": {"enum": ["carrier", "projected_carrier", "non_carrier", "container"]},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      },
      "additionalProperties": false
    },
    "capabilityMatrix": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "matrix_id", "entry_closure_sha256", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "capability_matrix"},
        "matrix_id": {"$ref": "#/$defs/nonEmptyString"},
        "entry_closure_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capabilityEntry"},
          "allOf": [
            {"contains": {"properties": {"tool_spec": {"const": "Function"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "Namespace"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "ToolSearch"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "LocalShell"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "ImageGeneration"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "WebSearch"}}, "required": ["tool_spec"]}},
            {"contains": {"properties": {"tool_spec": {"const": "Freeform"}}, "required": ["tool_spec"]}}
          ]
        }
      },
      "additionalProperties": false
    },
    "restoreTarget": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "rollbackManifest": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "baseline_authority_sha256", "baseline_production_sha256", "restore_targets", "verification_commands"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "rollback_manifest"},
        "baseline_authority_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_production_sha256": {"$ref": "#/$defs/sha256"},
        "restore_targets": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/restoreTarget"}},
        "verification_commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      },
      "additionalProperties": false
    },
    "sampleIdentity": {
      "type": "object",
      "required": ["id", "fixture_sha256", "repeats"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "repeats": {"type": "integer", "minimum": 3}
      },
      "additionalProperties": false
    },
    "continuousActionEvaluation": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "evaluation_id", "sealed", "samples", "metrics", "thresholds"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "continuous_action_evaluation"},
        "evaluation_id": {"$ref": "#/$defs/nonEmptyString"},
        "sealed": {"const": true},
        "samples": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sampleIdentity"}},
        "metrics": {"$ref": "#/$defs/metricSet"},
        "thresholds": {"$ref": "#/$defs/thresholdSet"}
      },
      "additionalProperties": false
    },
    "fla8Evaluation": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "evaluation_id", "sealed", "held_out_identity", "metrics", "thresholds"],
      "properties": {
        "schema_version": {"const": 1},
        "artifact_role": {"const": "fla8_evaluation_v2"},
        "evaluation_id": {"$ref": "#/$defs/nonEmptyString"},
        "sealed": {"const": true},
        "held_out_identity": {
          "type": "object",
          "required": ["suite_id", "manifest_sha256", "content_mounted"],
          "properties": {
            "suite_id": {"$ref": "#/$defs/nonEmptyString"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "content_mounted": {"const": false}
          },
          "additionalProperties": false
        },
        "metrics": {"$ref": "#/$defs/metricSet"},
        "thresholds": {"$ref": "#/$defs/thresholdSet"}
      },
      "additionalProperties": false
    }
  }
}
