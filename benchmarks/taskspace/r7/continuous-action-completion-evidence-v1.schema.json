{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/continuous-action-completion-evidence-v1.schema.json",
  "title": "R7 continuous-action completion evidence",
  "type": "object",
  "required": ["schema_version", "artifact_role", "candidate_id", "candidate_commit", "evaluation_contract", "raw_run_set", "evaluation_result", "completed_at_utc"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_role": {"const": "continuous_action_completion_evidence"},
    "candidate_id": {"$ref": "#/$defs/sha256"},
    "candidate_commit": {"$ref": "#/$defs/commit"},
    "evaluation_contract": {"$ref": "#/$defs/reference"},
    "raw_run_set": {"$ref": "#/$defs/reference"},
    "evaluation_result": {"$ref": "#/$defs/reference"},
    "completed_at_utc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"},
    "reference": {
      "type": "object",
      "required": ["path", "sha256", "git_mode"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "git_mode": {"const": "100644"}},
      "additionalProperties": false
    }
  }
}
