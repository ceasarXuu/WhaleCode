{
  "artifact_schema_version": 1,
  "contract_id": "r7-five-layer-taskspace-control-v2",
  "status": "selected_target",
  "activation_phase": "FLA-4",
  "baseline_tool_count": 1,
  "strict": false,
  "output_schema_sent_to_deepseek": false,
  "capability_profiles": {
    "apply_patch_visible": ["ordinary_tool", "apply_patch"],
    "apply_patch_hidden": ["ordinary_tool"],
    "mechanical_transform": "Remove apply_patch from every required_next_call enum when apply_patch is absent from the visible tool set; no other byte changes are permitted."
  },
  "provider_tool": {
    "type": "function",
    "function": {
      "name": "taskspace_control",
      "description": "Use taskspace_control to initialize and change the canonical TaskSpace Map, bind Work nodes, commit lifecycle transitions, expand folded node details, and read retained TaskSpace facts. Each call selects one action schema. Successful calls return the committed revision and exact delta or an exact read result; rejected calls return a structured error and whether any state was committed. Use it only for Map state and retained TaskSpace data, not to wrap ordinary tool names, commands, patch content, or reasoning. The Runtime validates mechanical graph and state invariants but never chooses nodes, repairs arguments, or decides the next action.",
      "parameters": {
        "type": "object",
        "description": "One mechanical TaskSpace operation.",
        "anyOf": [
          {
            "description": "Create the initial rooted DAG, its unique Finish, and the first active Work binding. Emit the first real non-control action as the next top-level sibling in the same response.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["initialize_map"]},
              "root": {
                "type": "object",
                "properties": {
                  "node_id": {"type": "string", "description": "Stable Agent-authored Root identifier."},
                  "goal": {"type": "string", "description": "The user's overall task goal."}
                },
                "required": ["node_id", "goal"],
                "additionalProperties": false
              },
              "initial_work_node": {
                "type": "object",
                "properties": {
                  "node_id": {"type": "string", "description": "Stable Agent-authored Work identifier."},
                  "goal": {"type": "string", "description": "The first coherent Work goal."}
                },
                "required": ["node_id", "goal"],
                "additionalProperties": false
              },
              "finish_identity": {
                "type": "object",
                "properties": {"id": {"type": "string", "description": "Stable Agent-authored Finish identifier."}},
                "required": ["id"],
                "additionalProperties": false
              },
              "additional_work_nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "node_id": {"type": "string", "description": "Stable Agent-authored Work identifier."},
                    "goal": {"type": "string", "description": "A coherent Work goal."}
                  },
                  "required": ["node_id", "goal"],
                  "additionalProperties": false
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {"type": "string", "description": "Source node identifier."},
                    "to": {"type": "string", "description": "Target node identifier."}
                  },
                  "required": ["from", "to"],
                  "additionalProperties": false
                }
              },
              "required_next_call": {
                "type": "string",
                "enum": ["ordinary_tool", "apply_patch"],
                "description": "Declare the immediately following top-level non-control sibling. This field does not execute or schedule that call."
              }
            },
            "required": ["action", "root", "initial_work_node", "finish_identity", "additional_work_nodes", "edges", "required_next_call"],
            "additionalProperties": false
          },
          {
            "description": "Atomically add Work nodes or dependency edges and remove eligible edges. Keep the existing binding unless the mutation is mechanically incompatible with it.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["mutate_graph"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "add_nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "node_id": {"type": "string"},
                    "goal": {"type": "string"}
                  },
                  "required": ["node_id", "goal"],
                  "additionalProperties": false
                }
              },
              "add_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"from": {"type": "string"}, "to": {"type": "string"}},
                  "required": ["from", "to"],
                  "additionalProperties": false
                }
              },
              "remove_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"from": {"type": "string"}, "to": {"type": "string"}},
                  "required": ["from", "to"],
                  "additionalProperties": false
                }
              },
              "required_next_call": {
                "type": "string",
                "enum": ["ordinary_tool", "apply_patch"],
                "description": "Optional declaration of an immediately following top-level non-control sibling under the unchanged binding."
              }
            },
            "required": ["action", "expected_revision", "add_nodes", "add_edges", "remove_edges"],
            "additionalProperties": false
          },
          {
            "description": "Bind one Agent-selected Ready Work node before its first ordinary action. Emit that real action as the next top-level sibling.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["bind_node"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "node_id": {"type": "string"},
              "required_next_call": {"type": "string", "enum": ["ordinary_tool", "apply_patch"]}
            },
            "required": ["action", "expected_revision", "node_id", "required_next_call"],
            "additionalProperties": false
          },
          {
            "description": "Mark the currently running Work node blocked. The Runtime does not select an alternative path.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["block_node"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "node_id": {"type": "string"}
            },
            "required": ["action", "expected_revision", "node_id"],
            "additionalProperties": false
          },
          {
            "description": "Return a blocked Work node to Ready after the Agent has determined that its blocker is cleared.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["unblock_node"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "node_id": {"type": "string"}
            },
            "required": ["action", "expected_revision", "node_id"],
            "additionalProperties": false
          },
          {
            "description": "Return a completed Work node to Ready because the Agent has decided that more work is required.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["rework_node"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "node_id": {"type": "string"}
            },
            "required": ["action", "expected_revision", "node_id"],
            "additionalProperties": false
          },
          {
            "description": "Atomically complete the active Work node and bind one Agent-selected Ready successor. Emit the successor's first real action as the next top-level sibling.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["complete_then_continue"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "current_node_id": {"type": "string"},
              "next_node_id": {"type": "string"},
              "required_next_call": {"type": "string", "enum": ["ordinary_tool", "apply_patch"]}
            },
            "required": ["action", "expected_revision", "current_node_id", "next_node_id", "required_next_call"],
            "additionalProperties": false
          },
          {
            "description": "Atomically complete the final active Work node, close the unique Finish and Root, and store the exact Agent-authored final summary.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["complete_then_end"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "current_node_id": {"type": "string"},
              "final_summary": {"type": "string"}
            },
            "required": ["action", "expected_revision", "current_node_id", "final_summary"],
            "additionalProperties": false
          },
          {
            "description": "Close a Map whose Finish is already Ready and no Work remains active. Store the exact Agent-authored final summary.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["finish_end"]},
              "expected_revision": {"type": "integer", "minimum": 0},
              "final_summary": {"type": "string"}
            },
            "required": ["action", "expected_revision", "final_summary"],
            "additionalProperties": false
          },
          {
            "description": "Mark folded node details for full inclusion in future projections. This changes only deterministic display state.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["expand_nodes"]},
              "node_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            },
            "required": ["action", "node_ids"],
            "additionalProperties": false
          },
          {
            "description": "Return the current full rendered Map and its canonical revision without changing state.",
            "type": "object",
            "properties": {"action": {"type": "string", "enum": ["read_map"]}},
            "required": ["action"],
            "additionalProperties": false
          },
          {
            "description": "Return the beginning of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["read_output_ref"]},
              "output_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["head"]},
              "max_bytes": {"type": "integer", "minimum": 1}
            },
            "required": ["action", "output_ref", "mode", "max_bytes"],
            "additionalProperties": false
          },
          {
            "description": "Return the end of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["read_output_ref"]},
              "output_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["tail"]},
              "max_bytes": {"type": "integer", "minimum": 1}
            },
            "required": ["action", "output_ref", "mode", "max_bytes"],
            "additionalProperties": false
          },
          {
            "description": "Return an exact retained output line range by reference.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["read_output_ref"]},
              "output_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["line_range"]},
              "start_line": {"type": "integer", "minimum": 1},
              "end_line": {"type": "integer", "minimum": 1},
              "max_bytes": {"type": "integer", "minimum": 1}
            },
            "required": ["action", "output_ref", "mode", "start_line", "end_line", "max_bytes"],
            "additionalProperties": false
          },
          {
            "description": "Return exact matching retained output ranges by reference and pattern.",
            "type": "object",
            "properties": {
              "action": {"type": "string", "enum": ["read_output_ref"]},
              "output_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["grep"]},
              "pattern": {"type": "string"},
              "max_bytes": {"type": "integer", "minimum": 1}
            },
            "required": ["action", "output_ref", "mode", "pattern", "max_bytes"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "invariants": [
    "initialize_map edges form one acyclic graph with one Root source and one Finish sink",
    "every Work node is reachable from Root and can reach Finish",
    "bind_node and complete_then_continue select an Agent-authored Ready Work node",
    "initialize_map, bind_node, and complete_then_continue have an immediately following top-level non-control sibling",
    "required_next_call is a declaration checked against the actual sibling and never schedules a call",
    "all control mutations compare expected_revision before commit and commit atomically",
    "read and expand actions never change graph lifecycle state",
    "one provider response may contain multiple control calls, but each call produces its own independent result envelope"
  ],
  "excluded_experiments": [
    "taskspace_control/taskspace_read split",
    "required_next_call removal",
    "DeepSeek strict mode",
    "DeepSeek provider-visible output schema",
    "MCP outputSchema"
  ]
}
