{
  "artifact_schema_version": 1,
  "contract_id": "r7-five-layer-taskspace-control-v2",
  "status": "active_repair_verified",
  "activation_phase": "FLA-3.5 repair; FLA-4 formalizes L4",
  "baseline_tool_count": 1,
  "strict": false,
  "output_schema_sent_to_deepseek": false,
  "capability_profiles": {
    "taskspace_transition": [
      "initialize_map",
      "bind_node",
      "complete_then_continue"
    ],
    "mechanical_transform": "Decorate TaskSpace ordinary action Tools with taskspace_transition; Standard schemas remain unchanged."
  },
  "provider_tool": {
    "type": "function",
    "function": {
      "name": "taskspace_control",
      "description": "Use taskspace_control for standalone Map mutations, lifecycle states that do not begin a new action, terminal closure, expansion, and retained-data reads. Initialization, binding, and complete-then-continue are carried by the next real action Tool through taskspace_transition. Successful calls return the committed revision and exact delta or an exact read result; rejected calls return a structured error and whether any state was committed. The Runtime validates mechanical graph and state invariants but never chooses nodes, repairs arguments, or decides the next action.",
      "parameters": {
        "type": "object",
        "description": "One mechanical TaskSpace operation.",
        "anyOf": [
          {
            "description": "Atomically add Work nodes or dependency edges and remove eligible edges. Keep the existing binding unless the mutation is mechanically incompatible with it.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "mutate_graph"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "add_nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "type": "string"
                    },
                    "goal": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "node_id",
                    "goal"
                  ],
                  "additionalProperties": false
                }
              },
              "add_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              },
              "remove_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "action",
              "expected_revision",
              "add_nodes",
              "add_edges",
              "remove_edges"
            ],
            "additionalProperties": false
          },
          {
            "description": "Mark the currently running Work node blocked. The Runtime does not select an alternative path.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "block_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return a blocked Work node to Ready after the Agent has determined that its blocker is cleared.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "unblock_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return a completed Work node to Ready because the Agent has decided that more work is required.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "rework_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Atomically complete the final active Work node, close the unique Finish and Root, and store the exact Agent-authored final summary.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "complete_then_end"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "current_node_id": {
                "type": "string"
              },
              "final_summary": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "current_node_id",
              "final_summary"
            ],
            "additionalProperties": false
          },
          {
            "description": "Close a Map whose Finish is already Ready and no Work remains active. Store the exact Agent-authored final summary.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "finish_end"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "final_summary": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "final_summary"
            ],
            "additionalProperties": false
          },
          {
            "description": "Mark folded node details for full inclusion in future projections. This changes only deterministic display state.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "expand_nodes"
                ]
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "action",
              "node_ids"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the current full rendered Map and its canonical revision without changing state.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_map"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the beginning of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "head"
                ]
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the end of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "tail"
                ]
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return an exact retained output line range by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "line_range"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "start_line",
              "end_line",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return exact matching retained output ranges by reference and pattern.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "grep"
                ]
              },
              "pattern": {
                "type": "string"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "pattern",
              "max_bytes"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "invariants": [
    "initialize_map, bind_node, and complete_then_continue are available only through an ordinary action Tool taskspace_transition",
    "all control mutations compare expected_revision before commit and commit atomically",
    "read and expand actions never change graph lifecycle state",
    "one provider response may contain multiple independent control calls, and each call produces its own result envelope"
  ],
  "excluded_experiments": [
    "taskspace_control/taskspace_read split",
    "DeepSeek strict mode",
    "DeepSeek provider-visible output schema",
    "MCP outputSchema"
  ]
}
