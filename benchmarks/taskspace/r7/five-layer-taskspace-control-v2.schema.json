{
  "artifact_schema_version": 1,
  "contract_id": "r7-five-layer-taskspace-control-v2",
  "status": "active_repair_verified",
  "activation_phase": "FLA-3.5 repair; FLA-4 formalizes L4",
  "baseline_tool_count": 1,
  "strict": false,
  "output_schema_sent_to_deepseek": false,
  "capability_profiles": {
    "taskspace_action": [
      "continue_current",
      "initialize_map",
      "bind_node",
      "complete_then_continue"
    ],
    "required_on_decorated_tools": true,
    "mechanical_transform": "Build raw Tool schemas in the shared registry, then decorate only TaskSpace provider-visible ordinary action Tools with required taskspace_action; Standard schemas remain unchanged.",
    "continuation_contract": "continue_current validates the submitted revision and active binding without changing Map state or interpreting task semantics."
  },
  "provider_tool": {
    "type": "function",
    "function": {
      "name": "taskspace_control",
      "description": "Use taskspace_control for standalone Map mutations, lifecycle states that do not begin a new action, terminal closure, expansion, and retained-data reads. Every ordinary action Tool explicitly declares taskspace_action: continue the current binding, or carry initialization, binding, or complete-then-continue into the action. Successful calls return the committed revision and exact delta or an exact read result; rejected calls return a structured error and whether any state was committed. The Runtime validates mechanical graph and state invariants but never chooses nodes, repairs arguments, or decides the next action.",
      "parameters": {
        "type": "object",
        "description": "One mechanical TaskSpace operation.",
        "anyOf": [
          {
            "description": "Atomically add Work nodes or dependency edges and remove eligible edges. Keep the existing binding unless the mutation is mechanically incompatible with it.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "mutate_graph"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "add_nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "type": "string"
                    },
                    "goal": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "node_id",
                    "goal"
                  ],
                  "additionalProperties": false
                }
              },
              "add_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              },
              "remove_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "action",
              "expected_revision",
              "add_nodes",
              "add_edges",
              "remove_edges"
            ],
            "additionalProperties": false
          },
          {
            "description": "Mark the currently running Work node blocked. The Runtime does not select an alternative path.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "block_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return a blocked Work node to Ready after the Agent has determined that its blocker is cleared.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "unblock_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return a completed Work node to Ready because the Agent has decided that more work is required.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "rework_node"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "node_id": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "node_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "Use only when current_node_id is the last Running Work and every other Work node is completed. Declare other_incomplete_work_status=none and finish_status=pending, then atomically complete the current Work, close the unique Finish and Root, and store the exact Agent-authored final summary.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "complete_last_running_work_then_end"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "current_node_id": {
                "type": "string"
              },
              "other_incomplete_work_status": {
                "description": "Caller-declared exact current state: every Work node other than current_node_id is completed.",
                "type": "string",
                "enum": [
                  "none"
                ]
              },
              "finish_status": {
                "description": "Caller-declared exact current state: the unique Finish is Pending on the current Work node.",
                "type": "string",
                "enum": [
                  "pending"
                ]
              },
              "final_summary": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "current_node_id",
              "other_incomplete_work_status",
              "finish_status",
              "final_summary"
            ],
            "additionalProperties": false
          },
          {
            "description": "Use only when the exact current state already has no active Work and the unique Finish is Ready. Declare active_work_status=none and finish_status=ready, then close the Finish and Root. This action does not complete a Work node; when the final Work node is Running, use complete_last_running_work_then_end instead.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "close_finish_with_no_active_work"
                ]
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 0
              },
              "active_work_status": {
                "description": "Caller-declared exact current state: no Work node is active.",
                "type": "string",
                "enum": [
                  "none"
                ]
              },
              "finish_status": {
                "description": "Caller-declared exact current state: the unique Finish is Ready.",
                "type": "string",
                "enum": [
                  "ready"
                ]
              },
              "final_summary": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "expected_revision",
              "active_work_status",
              "finish_status",
              "final_summary"
            ],
            "additionalProperties": false
          },
          {
            "description": "Mark folded node details for full inclusion in future projections. This changes only deterministic display state.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "expand_nodes"
                ]
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "action",
              "node_ids"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the current full rendered Map and its canonical revision without changing state.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_map"
                ]
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the beginning of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "head"
                ]
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return the end of exact retained output by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "tail"
                ]
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return an exact retained output line range by reference.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "line_range"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "start_line",
              "end_line",
              "max_bytes"
            ],
            "additionalProperties": false
          },
          {
            "description": "Return exact matching retained output ranges by reference and pattern.",
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "read_output_ref"
                ]
              },
              "output_ref": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "grep"
                ]
              },
              "pattern": {
                "type": "string"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "action",
              "output_ref",
              "mode",
              "pattern",
              "max_bytes"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "invariants": [
    "every decorated ordinary action Tool requires taskspace_action",
    "the shared registry retains raw Tool schemas and carrier decoration occurs only at the TaskSpace provider visibility boundary",
    "Standard provider-visible Tool schemas never contain taskspace_action",
    "continue_current requires the exact canonical revision and current Work binding and never mutates Map state",
    "initialize_map, bind_node, and complete_then_continue are available only through an ordinary action Tool taskspace_action",
    "all control mutations compare expected_revision before commit and commit atomically",
    "read and expand actions never change graph lifecycle state",
    "one provider response may contain multiple independent control calls, and each call produces its own result envelope"
  ],
  "excluded_experiments": [
    "taskspace_control/taskspace_read split",
    "DeepSeek strict mode",
    "DeepSeek provider-visible output schema",
    "MCP outputSchema"
  ]
}
