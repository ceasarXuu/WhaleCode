{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/candidate-artifact-content-v2.schema.json",
  "title": "R7 executable continuous-action candidate artifacts",
  "oneOf": [
    {"$ref": "#/$defs/l4Schema"},
    {"$ref": "#/$defs/transitionSchema"},
    {"$ref": "#/$defs/typedOutcome"},
    {"$ref": "#/$defs/carrierOracle"},
    {"$ref": "#/$defs/entryClosure"},
    {"$ref": "#/$defs/capabilityMatrix"},
    {"$ref": "#/$defs/rollbackManifest"},
    {"$ref": "#/$defs/evaluation"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 3},
    "sourceBinding": {
      "type": "object",
      "required": ["symbol", "path", "sha256"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^third_party/codex-cli/codex-rs/.+\\.rs$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "l4Schema": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "reserved_field", "collision_policy", "carrier_specs", "standard_identity"],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_role": {"const": "l4_schema"},
        "reserved_field": {"const": "taskspace_transition"},
        "collision_policy": {"const": "reject_capability_epoch"},
        "carrier_specs": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/carrierSpec"}},
        "standard_identity": {"type": "object", "required": ["tool_schema_sha256", "wire_sha256", "handler_sha256"], "properties": {"tool_schema_sha256": {"$ref": "#/$defs/sha256"}, "wire_sha256": {"$ref": "#/$defs/sha256"}, "handler_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "carrierSpec": {
      "type": "object",
      "required": ["wire_api", "tool_spec", "business_schema_sha256", "decorated_schema_sha256", "parser", "reserved_field_removed_before_handler"],
      "properties": {
        "wire_api": {"enum": ["responses", "deepseek_chat"]},
        "tool_spec": {"enum": ["Function", "Namespace", "Freeform", "CodeModeOuter"]},
        "business_schema_sha256": {"$ref": "#/$defs/sha256"},
        "decorated_schema_sha256": {"$ref": "#/$defs/sha256"},
        "parser": {"$ref": "#/$defs/sourceBinding"},
        "reserved_field_removed_before_handler": {"const": true}
      },
      "additionalProperties": false
    },
    "transitionSchema": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "schema_id", "input_schema", "positive_fixtures", "negative_fixtures"],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_role": {"const": "transition_schema"},
        "schema_id": {"const": "r7-taskspace-transition-v2"},
        "input_schema": {"type": "object", "required": ["$schema", "oneOf"], "properties": {"$schema": {"const": "https://json-schema.org/draft/2020-12/schema"}, "oneOf": {"type": "array", "minItems": 3}}, "additionalProperties": true},
        "positive_fixtures": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/transitionFixture"}},
        "negative_fixtures": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/transitionFixture"}}
      },
      "additionalProperties": false
    },
    "transitionFixture": {
      "type": "object",
      "required": ["id", "input_sha256", "pre_state_sha256", "expected_output_sha256", "post_state_sha256", "accepted"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "pre_state_sha256": {"$ref": "#/$defs/sha256"},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "post_state_sha256": {"$ref": "#/$defs/sha256"},
        "accepted": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "typedOutcome": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "outcome_type", "variants", "deferred_authorization_variants", "mcp_presence_fields", "fixtures"],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_role": {"const": "typed_outcome"},
        "outcome_type": {"const": "TaskSpaceCarrierOutcome"},
        "variants": {"const": ["RejectedBeforeCommit", "CommittedNotExecuted", "Executed"]},
        "deferred_authorization_variants": {"const": ["NotRequired", "Requested", "Approved", "Denied"]},
        "mcp_presence_fields": {"const": ["content", "structured_content", "is_error", "meta"]},
        "fixtures": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/outcomeFixture"}}
      },
      "additionalProperties": false
    },
    "outcomeFixture": {
      "type": "object",
      "required": ["id", "variant", "input_sha256", "output_sha256", "commit_state", "tool_state"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "variant": {"enum": ["RejectedBeforeCommit", "CommittedNotExecuted", "Executed"]},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "commit_state": {"enum": ["not_committed", "committed"]},
        "tool_state": {"enum": ["not_dispatched", "not_started", "returned", "failed", "cancelled_after_start"]}
      },
      "additionalProperties": false
    },
    "carrierOracle": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "oracle_version", "scenarios"],
      "properties": {
        "schema_version": {"const": 2},
        "artifact_role": {"const": "carrier_protocol_oracle"},
        "oracle_version": {"const": 3},
        "scenarios": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/oracleScenario"}}
      },
      "additionalProperties": false
    },
    "oracleScenario": {
      "type": "object",
      "required": ["id", "fixture_path", "fixture_sha256", "expected_outcome_sha256"],
      "properties": {"id": {"type": "string", "minLength": 3}, "fixture_path": {"$ref": "#/$defs/path"}, "fixture_sha256": {"$ref": "#/$defs/sha256"}, "expected_outcome_sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "closureEntry": {
      "type": "object",
      "required": ["profile_id", "wire_api", "tool_name", "namespace", "tool_spec", "tool_payload", "handler_kind", "registration_source", "invocation_origin", "route", "disposition", "reason_code", "model_visible", "supports_parallel", "pipeline"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "wire_api": {"enum": ["responses", "deepseek_chat"]},
        "tool_name": {"type": "string", "minLength": 1},
        "namespace": {"type": ["string", "null"]},
        "tool_spec": {"enum": ["Function", "Namespace", "ToolSearch", "LocalShell", "ImageGeneration", "WebSearch", "Freeform"]},
        "tool_payload": {"enum": ["Function", "ToolSearch", "Custom", "LocalShell", "Mcp", "NotApplicable"]},
        "handler_kind": {"type": ["string", "null"]},
        "registration_source": {"enum": ["builtin", "dynamic", "mcp"]},
        "invocation_origin": {"enum": ["direct", "code_mode"]},
        "route": {"enum": ["function", "namespace", "tool_search", "local_shell", "image_generation", "web_search", "apply_patch", "code_exec"]},
        "disposition": {"enum": ["carrier", "projected_carrier", "non_carrier", "container"]},
        "reason_code": {"enum": ["shared_function_handler", "namespace_container", "provider_native", "freeform_projection", "code_mode_outer", "state_tool_excluded", "decorated_namespace_function", "deferred_registry", "provider_wire_unsupported"]},
        "model_visible": {"type": "boolean"},
        "supports_parallel": {"type": "boolean"},
        "pipeline": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/sourceBinding"}}
      },
      "additionalProperties": false
    },
    "sourceInventory": {
      "type": "object",
      "required": ["roots", "tool_spec_variants", "tool_payload_variants", "tool_handler_variants", "bindings", "scanned_sources", "inventory_sha256"],
      "properties": {
        "roots": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "tool_spec_variants": {"const": ["Function", "Namespace", "ToolSearch", "LocalShell", "ImageGeneration", "WebSearch", "Freeform"]},
        "tool_payload_variants": {"const": ["Function", "ToolSearch", "Custom", "LocalShell", "Mcp"]},
        "tool_handler_variants": {"const": ["AgentJobs", "ApplyPatch", "CloseAgentV1", "CloseAgentV2", "CodeModeExecute", "CodeModeWait", "DynamicTool", "FollowupTaskV2", "Goal", "ListAgentsV2", "ListDir", "Mcp", "McpResource", "Plan", "RequestPermissions", "RequestUserInput", "ResumeAgentV1", "SendInputV1", "SendMessageV2", "Shell", "ShellCommand", "SpawnAgentV1", "SpawnAgentV2", "TaskSpaceControl", "TestSync", "ToolSearch", "ToolSuggest", "UnifiedExec", "ViewImage", "WebFetch", "WebSearch", "WaitAgentV1", "WaitAgentV2"]},
        "bindings": {"type": "object", "minProperties": 12, "additionalProperties": {"$ref": "#/$defs/sourceBinding"}},
        "scanned_sources": {"type": "object", "minProperties": 20, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "entryClosure": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "generator_version", "generated", "source_inventory", "generation_digest", "entries"],
      "properties": {
        "schema_version": {"const": 2}, "artifact_role": {"const": "entry_closure"}, "generator_version": {"const": 1}, "generated": {"const": true},
        "source_inventory": {"$ref": "#/$defs/sourceInventory"}, "generation_digest": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/closureEntry"}}
      },
      "additionalProperties": false
    },
    "capabilityMatrix": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "entry_closure_sha256", "entries"],
      "properties": {
        "schema_version": {"const": 2}, "artifact_role": {"const": "capability_matrix"},
        "entry_closure_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/closureEntry"}}
      },
      "additionalProperties": false
    },
    "rollbackManifest": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "baseline_commit", "baseline_authority_sha256", "baseline_production_sha256", "changed_paths", "changed_path_inventory", "restore_targets", "commands"],
      "properties": {
        "schema_version": {"const": 2}, "artifact_role": {"const": "rollback_manifest"}, "baseline_commit": {"$ref": "#/$defs/commit"},
        "baseline_authority_sha256": {"$ref": "#/$defs/sha256"}, "baseline_production_sha256": {"$ref": "#/$defs/sha256"},
        "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "changed_path_inventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "required": ["path", "rollback_action", "candidate_sha256", "git_mode"], "properties": {"path": {"$ref": "#/$defs/path"}, "rollback_action": {"enum": ["restore", "remove", "preserve"]}, "baseline_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "git_mode": {"const": "100644"}}, "additionalProperties": false}},
        "restore_targets": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "required": ["path", "sha256", "git_mode"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "git_mode": {"const": "100644"}}, "additionalProperties": false}},
        "commands": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 10}}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object", "required": ["formula", "unit"],
      "properties": {"formula": {"type": "string", "pattern": "^[a-z_]+( / | - | \\+ )[a-z_]+|^count\\(|^sum\\("}, "unit": {"enum": ["ratio", "count", "tokens", "milliseconds"]}},
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["schema_version", "artifact_role", "evaluation_id", "sealed", "seed", "arm_order", "sample_order", "samples", "metrics", "thresholds", "statistics", "bootstrap", "stopping", "correction", "contract_digest"],
      "properties": {
        "schema_version": {"const": 2}, "artifact_role": {"const": "continuous_action_evaluation"}, "evaluation_id": {"const": "r7-fla3-5-continuous-action-v1"}, "sealed": {"const": true},
        "seed": {"type": "integer", "minimum": 1}, "arm_order": {"const": ["standard", "sibling_baseline", "fla3_5_candidate"]},
        "sample_order": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "samples": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "object", "required": ["category", "fixture_path", "fixture_sha256", "repeats"], "properties": {"category": {"enum": ["simple", "complex", "carrier_validation"]}, "fixture_path": {"$ref": "#/$defs/path"}, "fixture_sha256": {"$ref": "#/$defs/sha256"}, "repeats": {"type": "integer", "minimum": 3}}, "additionalProperties": false}},
        "metrics": {"type": "object", "minProperties": 14, "additionalProperties": {"$ref": "#/$defs/metric"}},
        "thresholds": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "number"}},
        "statistics": {"const": {"aggregates": ["total", "mean", "median"], "paired_by": ["sample", "repeat"], "adaptive_stop": false}},
        "bootstrap": {"const": {"method": "paired_percentile", "resamples": 10000, "confidence": 0.95, "seed_offset": 1}},
        "stopping": {"const": {"adaptive": false, "complete_all_preregistered_runs": true}},
        "correction": {"const": {"method": "holm", "familywise_alpha": 0.05}},
        "contract_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
