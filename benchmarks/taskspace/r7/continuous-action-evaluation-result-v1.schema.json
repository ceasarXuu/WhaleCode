{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/continuous-action-evaluation-result-v1.schema.json",
  "title": "R7 recomputed continuous-action evaluation result",
  "type": "object",
  "required": ["schema_version", "artifact_role", "evaluation_id", "decision", "hard_gates", "codes", "run_count", "pair_count", "metrics_by_arm", "paired_facts", "bootstrap", "holm"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_role": {"const": "continuous_action_evaluation_result"},
    "evaluation_id": {"const": "r7-fla3-5-continuous-action-v1"},
    "decision": {"enum": ["pass", "fail", "inconclusive"]},
    "hard_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R7_[A-Z0-9_]+$"}},
    "run_count": {"type": "integer", "minimum": 0},
    "pair_count": {"type": "integer", "minimum": 0},
    "metrics_by_arm": {"type": "object", "required": ["standard", "sibling_baseline", "fla3_5_candidate"]},
    "paired_facts": {"type": "array"},
    "bootstrap": {"type": "object", "required": ["method", "confidence", "resamples", "seed", "metrics"]},
    "holm": {"type": "object", "required": ["method", "familywise_alpha", "metrics"]}
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {"type": "object", "required": ["code", "passed", "detail"], "properties": {"code": {"type": "string", "pattern": "^R7_[A-Z0-9_]+$"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}, "additionalProperties": false}
  }
}
