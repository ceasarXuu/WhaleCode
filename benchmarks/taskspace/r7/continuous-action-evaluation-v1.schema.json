{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/continuous-action-evaluation-v1.schema.json",
  "title": "R7 continuous-action pinned evaluation contract",
  "type": "object",
  "required": ["schema_version", "artifact_role", "evaluation_id", "sealed", "seed", "arm_order", "sample_order", "samples", "metrics", "thresholds", "statistics", "bootstrap", "stopping", "correction", "identity", "evaluator", "contract_digest"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_role": {"const": "continuous_action_evaluation"},
    "evaluation_id": {"const": "r7-fla3-5-continuous-action-v1"},
    "sealed": {"const": true},
    "seed": {"type": "integer", "minimum": 1},
    "arm_order": {"const": ["standard", "sibling_baseline", "fla3_5_candidate"]},
    "sample_order": {"const": ["carrier_validation_dev", "single_file_fast_fix", "subscription_billing_repair"]},
    "samples": {
      "type": "object",
      "required": ["carrier_validation_dev", "single_file_fast_fix", "subscription_billing_repair"],
      "properties": {
        "carrier_validation_dev": {"$ref": "#/$defs/sample"},
        "single_file_fast_fix": {"$ref": "#/$defs/sample"},
        "subscription_billing_repair": {"$ref": "#/$defs/sample"}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "object", "minProperties": 17, "additionalProperties": {"$ref": "#/$defs/metric"}},
    "thresholds": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "number"}},
    "statistics": {"type": "object", "required": ["aggregates", "paired_by", "adaptive_stop", "paired_facts"], "properties": {"aggregates": {"const": ["total", "mean", "median"]}, "paired_by": {"const": ["sample", "repeat"]}, "adaptive_stop": {"const": false}, "paired_facts": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "bootstrap": {"type": "object", "required": ["method", "resamples", "confidence", "seed_offset", "statistics"], "properties": {"method": {"const": "paired_percentile"}, "resamples": {"const": 10000}, "confidence": {"const": 0.95}, "seed_offset": {"const": 1}, "statistics": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "stopping": {"type": "object", "required": ["adaptive", "complete_all_preregistered_runs", "extra_samples", "missing_runs", "held_out_policy"], "properties": {"adaptive": {"const": false}, "complete_all_preregistered_runs": {"const": true}, "extra_samples": {"const": "reject"}, "missing_runs": {"const": "reject"}, "held_out_policy": {"const": "reject"}}, "additionalProperties": false},
    "correction": {"type": "object", "required": ["method", "familywise_alpha", "family"], "properties": {"method": {"const": "holm"}, "familywise_alpha": {"const": 0.05}, "family": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false},
    "identity": {"type": "object", "required": ["contract_directory_identity_sha256", "directory_identity_fields", "sealed_raw_run_set_schema"], "properties": {"contract_directory_identity_sha256": {"$ref": "#/$defs/sha256"}, "directory_identity_fields": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}, "sealed_raw_run_set_schema": {"const": "continuous-action-raw-run-set-v1.schema.json"}}, "additionalProperties": false},
    "evaluator": {"type": "object", "required": ["pinned_script", "result_schema", "completion_evidence_schema", "summary_trust_policy"], "properties": {"pinned_script": {"const": "scripts/taskspace-benchmark/evaluate-r7-continuous-action-runset.ps1"}, "result_schema": {"const": "continuous-action-evaluation-result-v1.schema.json"}, "completion_evidence_schema": {"const": "continuous-action-completion-evidence-v1.schema.json"}, "summary_trust_policy": {"const": "ignore_summary_booleans_recompute_from_artifacts"}}, "additionalProperties": false},
    "contract_digest": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "sample": {
      "type": "object",
      "required": ["category", "fixture_path", "fixture_sha256", "directory_root", "directory_manifest_sha256", "prompt_path", "prompt_sha256", "fixture_root", "fixture_manifest_sha256", "oracle_path", "oracle_sha256", "repeats", "held_out", "source_set", "identity_mode"],
      "properties": {
        "category": {"enum": ["simple", "complex", "carrier_validation"]},
        "fixture_path": {"type": "string", "minLength": 3},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "directory_root": {"type": "string", "minLength": 3},
        "directory_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_path": {"type": "string", "minLength": 3},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_root": {"type": "string", "minLength": 3},
        "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "oracle_path": {"type": "string", "minLength": 3},
        "oracle_sha256": {"$ref": "#/$defs/sha256"},
        "repeats": {"type": "integer", "minimum": 3},
        "held_out": {"const": false},
        "source_set": {"const": "ca0_dev_only"},
        "identity_mode": {"const": "full_directory_manifest"}
      },
      "additionalProperties": false
    },
    "metric": {"type": "object", "required": ["formula", "unit"], "properties": {"formula": {"type": "string", "minLength": 3}, "unit": {"enum": ["ratio", "count", "tokens", "milliseconds"]}}, "additionalProperties": false}
  }
}
