{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whalecode.dev/schemas/r7/r7-held-out-set-v1.schema.json",
  "title": "R7.1 sealed held-out sample set",
  "type": "object",
  "required": ["schema_version", "artifact_type", "sample_ids"],
  "properties": {
    "schema_version": {"const": "r71-held-out-set-v1"},
    "artifact_type": {"const": "held_out_sample_manifest"},
    "sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
