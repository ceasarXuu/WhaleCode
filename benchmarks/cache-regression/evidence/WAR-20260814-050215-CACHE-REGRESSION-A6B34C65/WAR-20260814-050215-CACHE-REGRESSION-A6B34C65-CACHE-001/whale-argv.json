{
  "logical_mode": "taskspace",
  "argv": [
    "exec",
    "--json",
    "--taskspace",
    "-c",
    "model_reasoning_effort=\"max\"",
    "-c",
    "features.plugins=false",
    "-c",
    "model_provider=\"deepseek-boundary\"",
    "-c",
    "model_providers.deepseek-boundary.name=\"DeepSeek\"",
    "-c",
    "model_providers.deepseek-boundary.base_url=\"http://provider-proxy:8080\"",
    "-c",
    "model_providers.deepseek-boundary.env_key=\"DEEPSEEK_API_KEY\"",
    "-c",
    "model_providers.deepseek-boundary.env_key_instructions=\"Set DEEPSEEK_API_KEY to a DeepSeek API key before starting Whale.\"",
    "-c",
    "model_providers.deepseek-boundary.wire_api=\"responses\"",
    "-c",
    "taskspace_projection_policy=\"map-request\"",
    "-m",
    "deepseek-v4-flash",
    "-C",
    "/workspace",
    "--dangerously-bypass-approvals-and-sandbox",
    "--output-last-message",
    "/artifacts/last-message.md",
    "-"
  ],
  "common_argv_without_treatment": [
    "exec",
    "--json",
    "-c",
    "model_reasoning_effort=\"max\"",
    "-c",
    "features.plugins=false",
    "-c",
    "model_provider=\"deepseek-boundary\"",
    "-c",
    "model_providers.deepseek-boundary.name=\"DeepSeek\"",
    "-c",
    "model_providers.deepseek-boundary.base_url=\"http://provider-proxy:8080\"",
    "-c",
    "model_providers.deepseek-boundary.env_key=\"DEEPSEEK_API_KEY\"",
    "-c",
    "model_providers.deepseek-boundary.env_key_instructions=\"Set DEEPSEEK_API_KEY to a DeepSeek API key before starting Whale.\"",
    "-c",
    "model_providers.deepseek-boundary.wire_api=\"responses\"",
    "-m",
    "deepseek-v4-flash",
    "-C",
    "/workspace",
    "--dangerously-bypass-approvals-and-sandbox",
    "--output-last-message",
    "/artifacts/last-message.md",
    "-"
  ],
  "treatment_delta": [
    "--taskspace",
    "-c taskspace_projection_policy=\"map-request\""
  ],
  "execution_substrate": "docker",
  "container_workdir": "/workspace",
  "child_environment": {
    "WHALE_TASKSPACE_PROFILE_NAME": "taskspace-v005-thin",
    "WHALE_TASKSPACE_ROUTE_MODE": "thin",
    "RUST_LOG": "error,codex_core::taskspace_exec=info",
    "WHALE_PROVIDER_BOUNDARY": "docker-isolated-proxy-v1",
    "WHALE_PROVIDER_WIRE_TRACE_PATH": "/artifacts/provider-wire-trace.jsonl"
  },
  "provider_routing": {
    "route_kind": "custom_provider_transport_alias",
    "logical_provider_id": "deepseek",
    "transport_provider_id": "deepseek-boundary",
    "provider_name": "DeepSeek",
    "base_url": "http://provider-proxy:8080",
    "env_key": "DEEPSEEK_API_KEY",
    "wire_api": "responses",
    "intentional_differences": [
      "provider_id",
      "base_url"
    ]
  }
}
