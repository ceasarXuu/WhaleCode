{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "cutover_batches": {"items": {"type": "object"}, "minItems": 1, "type": "array"},
    "entries": {"items": {"type": "object"}, "type": "array"},
    "overlay_tree": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": 1},
    "summary": {"type": "object"},
    "target_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "required": ["schema_version", "baseline_commit", "target_commit", "overlay_tree", "cutover_batches", "entries", "summary"],
  "title": "Whale overlay replay decision ledger",
  "type": "object"
}
