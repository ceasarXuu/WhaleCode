{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProviderAccessMethod": {
      "description": "Authentication path used for a provider route. This enum never carries credentials.",
      "enum": [
        "chatgpt",
        "apiKey"
      ],
      "type": "string"
    },
    "ProviderCredentialStatus": {
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "route": {
          "$ref": "#/definitions/ProviderRoute"
        }
      },
      "required": [
        "configured",
        "route"
      ],
      "type": "object"
    },
    "ProviderRoute": {
      "description": "Non-secret identity for selecting a model provider and its authentication path.",
      "properties": {
        "accessMethod": {
          "$ref": "#/definitions/ProviderAccessMethod"
        },
        "modelProviderId": {
          "type": "string"
        }
      },
      "required": [
        "accessMethod",
        "modelProviderId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/ProviderCredentialStatus"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "ProviderCredentialStatusListResponse",
  "type": "object"
}