              "description": "Maximum number of characters to return. Defaults to the configured limit.",
              "type": "integer"
            },
            "reason": {
              "description": "Brief reason this URL is needed for the current task.",
              "type": "string"
            },
            "url": {
              "description": "HTTP or HTTPS URL to read.",
              "type": "string"
            }
          },
          "required": [
            "url",
            "reason"
          ],
          "type": "object"
        },
        "strict": false,
        "type": "function"
      },
      {
        "description": "View a local image from the filesystem (only use if given a full filepath by the user, and the image isn't already attached to the thread context within <image ...> tags).",
        "name": "view_image",
        "parameters": {
          "additionalProperties": false,
          "properties": {
