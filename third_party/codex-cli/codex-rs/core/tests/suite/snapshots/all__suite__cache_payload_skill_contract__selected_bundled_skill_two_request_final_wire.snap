      {
        "description": "Resume a previously closed agent by id so it can receive send_input and wait_agent calls.",
        "name": "resume_agent",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "description": "Agent id to resume.",
              "type": "string"
            }
          },
          "required": [
